{
  "name": "viberhub",
  "version": "1.0.0",
  "private": true,
  "description": "Viber Messaging Hub — Self-hosted workspace for organizing contacts, preparing content, and coordinating operator-led Viber communication",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev": "npm run dev:api & npm run dev:web",
    "dev:api": "npm run dev --workspace=@viberhub/api",
    "dev:web": "npm run dev --workspace=@viberhub/web",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node prisma/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "prisma": "^5.10.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
