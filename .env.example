# Runtime
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000/api/v1

# PostgreSQL / Redis
DATABASE_URL=postgresql://viberhub:viberhub_password@localhost:5432/viberhub?schema=public
REDIS_URL=redis://localhost:6379

# Session and security secrets (generate unique 32+ character secrets for production)
SESSION_SECRET=dev-session-secret-change-me-in-production-min-32-chars
CSRF_SECRET=dev-csrf-secret-change-me-in-production-min-32-chars
PASSWORD_RESET_SECRET=dev-password-reset-secret-change-me-in-production-min-32-chars

# MinIO / S3-compatible storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=viber-hub-private
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false
# Local storage fallback directory if S3 is not configured
LOCAL_STORAGE_PATH=./uploads

# Optional email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@viberhub.local

# Operations
LOG_LEVEL=info
MAX_UPLOAD_BYTES=20971520
BACKUP_ENCRYPTION_KEY=dev-backup-key-min-32-characters-long
