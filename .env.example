# Runtime
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000, http://[IP_ADDRESS]
API_PUBLIC_URL=http://localhost:4000/api/v1, http://[IP_ADDRESS]/api/v1

# PostgreSQL / Redis
DATABASE_URL=postgresql://postgres:Darknezz7@localhost:5432/viberhub?schema=public
REDIS_URL=redis://localhost:6379

# Session and security secrets (generate unique 32+ character secrets for production)
SESSION_SECRET=dev-session-secret-change-me-in-production-min-32-chars
CSRF_SECRET=dev-csrf-secret-change-me-in-production-min-32-chars
PASSWORD_RESET_SECRET=dev-password-reset-secret-change-me-in-production-min-32-chars

# R2 Storage (mvcdn.cc)
STORAGE_PROVIDER=r2storage
R2_ENDPOINT=https://cdn.mvcdn.cc/s3
R2_BUCKET=viberhub
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Local storage cache / fallback directory
LOCAL_STORAGE_PATH=./uploads

# Optional email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@viberhub.local

# Operations
LOG_LEVEL=info
MAX_UPLOAD_BYTES=20971520
BACKUP_ENCRYPTION_KEY=dev-backup-key-min-32-characters-long
